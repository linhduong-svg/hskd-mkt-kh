      borderRadius:3, borderSkipped:false, barPercentage:0.55, categoryPercentage:0.8
    }]},
    options:hOpts(v=>v+'%', ctx=>`CVR: ${ctx.raw}%`, {suggestedMax:30})
  });

  if(tRT)tRT.destroy();
  tRT=new Chart(document.getElementById('teamRespChart'),{
    type:'bar',
    data:{labels:teamNames,datasets:[{
      label:'Phản hồi', data:teamMktData.respTime,
      backgroundColor:teamMktData.respTime.map(v=>v<=2?'rgba(18,163,114,0.82)':v<=3?'rgba(212,150,10,0.82)':'rgba(229,48,48,0.82)'),
