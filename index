      plugins:{legend:{display:false}, tooltip:{callbacks:{label:tipCb}}},
      scales:{
        x:{ticks:{color:TK,font:{size:11},callback:xCb}, grid:{color:GR}, ...(xExtra||{})},
        y:{ticks:{color:'#1a1a2e',font:{size:12},weight:'bold'}, grid:{display:false}}
