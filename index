    options:hOpts(v=>v+'h', ctx=>`${ctx.raw}h`)
  });

  if(tOT)tOT.destroy();
  tOT=new Chart(document.getElementById('teamOrderTimeChart'),{
    type:'bar',
    data:{labels:teamNames,datasets:[{
      label:'Ra đơn', data:teamMktData.orderTime,
