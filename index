            </tr>`;
          });
        }
      });

      // NV subtotal row
      rows+=`<tr style="background:#fce4f1;border-bottom:2px solid #e91e8c40;">
        <td style="padding:7px 12px 7px 28px;font-weight:700;font-size:11px;color:#a0186a;position:sticky;left:0;background:#fce4f1;white-space:nowrap;">Tổng ${team.name}</td>
        ${MX_COLS.map(c=>`<td style="padding:7px 10px;text-align:right;font-weight:700;font-size:11px;color:#a0186a;">${c.fmt(team[c.key])}</td>`).join('')}
      </tr>`;
    }
  });

  // Grand total
  const gt={kg:0,kgPhu:0,dt:0,ship:0,disc:0,cono:0,dtThuc:0};
  window.matrixData.forEach(t=>{MX_COLS.forEach(c=>{gt[c.key]+=t[c.key];});});
  rows+=`<tr style="background:#1a1a2e;">
    <td style="padding:10px 12px;font-weight:800;font-size:12px;color:#fff;position:sticky;left:0;background:#1a1a2e;white-space:nowrap;">Tổng cộng</td>
