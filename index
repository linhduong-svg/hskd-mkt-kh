<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard Hiệu Suất Kinh Doanh</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --black:#1a1a2e; --black2:#16213e;
  --pink:#e91e8c; --pink2:#d4158a; --pink-light:#fce4f3; --pink-pale:#fdf0f9;
  --teal:#0ab5a0; --amber:#d4960a; --blue:#3b6fd4; --purple:#6b3fa0;
  --green:#12a372; --red:#e53030;
  --surface:#ffffff; --bg:#f5f5f8;
  --border:#e8ddf0; --border-card:#e0e0ec;
  --text:#1a1a2e; --text2:#5a5a7a; --text3:#a0a0c0;
  --radius:8px; --radius-sm:5px;
}
body{background:var(--bg);color:var(--text);font-family:'Segoe UI',system-ui,sans-serif;font-size:13px;min-height:100vh;}

/* ── TOP NAV ── */
.topnav{background:var(--black);height:44px;display:flex;align-items:center;padding:0 20px;gap:0;position:sticky;top:0;z-index:200;}
.brand{font-size:16px;font-weight:800;font-style:italic;color:#fff;margin-right:18px;letter-spacing:-0.5px;}
.nav-sep{color:rgba(255,255,255,0.25);margin:0 14px;font-size:18px;}
.nav-label{color:rgba(255,255,255,0.5);font-size:12px;}
.nav-tabs{display:flex;gap:0;margin-left:18px;}
.nav-tab{display:flex;align-items:center;gap:6px;padding:0 18px;height:44px;color:rgba(255,255,255,0.5);font-size:12px;font-weight:600;cursor:pointer;border-bottom:2px solid transparent;transition:all 0.2s;}
.nav-tab.active{color:#fff;border-bottom-color:var(--pink);}
.nav-tab .num{background:var(--pink);color:#fff;width:16px;height:16px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;}
.nav-tab.active2 .num{background:#555;}
.nav-right{margin-left:auto;display:flex;gap:8px;}
.nav-pill{background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.18);color:rgba(255,255,255,0.75);padding:4px 12px;border-radius:4px;font-size:11px;cursor:pointer;}

/* ── SUBHEADER ── */
.subheader{background:var(--pink);padding:10px 20px;display:flex;align-items:center;justify-content:space-between;}
.subheader-left h2{font-size:15px;font-weight:700;color:#fff;}
.subheader-left p{font-size:11px;color:rgba(255,255,255,0.7);margin-top:1px;}
.subheader-pills{display:flex;gap:8px;}
.sh-pill{background:rgba(255,255,255,0.22);border:1px solid rgba(255,255,255,0.3);color:#fff;padding:4px 14px;border-radius:20px;font-size:12px;font-weight:600;}

/* ── FILTERS ── */
.filters{background:#fff;border-bottom:1px solid var(--border-card);padding:8px 20px;display:flex;gap:10px;flex-wrap:wrap;align-items:center;}
.filter-label{color:var(--text2);font-size:11px;text-transform:uppercase;letter-spacing:0.4px;font-weight:600;}
.filter-group{display:flex;align-items:center;gap:6px;}
select,input[type=date]{background:#fff;border:1px solid var(--border-card);color:var(--text);padding:4px 10px;border-radius:var(--radius-sm);font-size:12px;cursor:pointer;outline:none;transition:border 0.2s;}
select:hover,input[type=date]:hover{border-color:var(--pink);}
.filter-sep{color:var(--text3);}
.btn-reset{background:transparent;border:1px solid var(--border-card);color:var(--text2);padding:4px 12px;border-radius:var(--radius-sm);font-size:11px;cursor:pointer;transition:all 0.2s;}
.btn-reset:hover{border-color:var(--pink);color:var(--pink);}

/* ── MAIN ── */
.main{padding:16px 20px;display:flex;flex-direction:column;gap:14px;}

/* ── KPI CARDS ── */
.kpi-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;}
.kpi-card{background:#fff;border:1px solid var(--border-card);border-top:3px solid;border-radius:var(--radius);padding:14px 16px;transition:box-shadow 0.2s;}
.kpi-card:hover{box-shadow:0 3px 14px rgba(0,0,0,0.08);}
.kpi-card.k1{border-top-color:var(--pink);}
.kpi-card.k2{border-top-color:var(--teal);}
.kpi-card.k3{border-top-color:var(--amber);}
.kpi-card.k4{border-top-color:var(--blue);}
.kpi-card.k5{border-top-color:var(--purple);}
.kpi-card.k6{border-top-color:#e53030;}
.kpi-label{font-size:10px;color:var(--text3);margin-bottom:5px;text-transform:uppercase;letter-spacing:0.5px;font-weight:700;}
.kpi-value{font-size:26px;font-weight:800;letter-spacing:-1px;line-height:1;color:var(--text);}
.kpi-trend{display:flex;align-items:center;gap:3px;margin-top:5px;font-size:11px;}
.trend-up{color:var(--green);font-weight:600;} .trend-down{color:var(--red);font-weight:600;}
.kpi-sub{color:var(--text3);font-size:10px;}

/* ── CHART CARDS ── */
.row2-grid{display:grid;grid-template-columns:2fr 1fr;gap:12px;}
.row3-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.row4-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
.chart-card{background:#fff;border:1px solid var(--border-card);border-radius:var(--radius);padding:16px;}
.chart-head{margin-bottom:10px;}
.chart-title{font-size:13px;font-weight:700;color:var(--text);}
.chart-sub{font-size:11px;color:var(--text3);margin-top:1px;}
.chart-header-row{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:10px;flex-wrap:wrap;gap:6px;}
.chart-filters{display:flex;gap:5px;flex-wrap:wrap;}
.toggle-btn{background:var(--pink-pale);border:1px solid #e8c8dd;color:var(--text2);padding:3px 10px;border-radius:20px;font-size:11px;cursor:pointer;transition:all 0.18s;font-weight:500;}
.toggle-btn.active{background:var(--pink);border-color:var(--pink);color:#fff;font-weight:600;}
.toggle-btn:hover:not(.active){background:var(--pink-light);}
.legend{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:6px;}
.legend-item{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--text2);}
.legend-dot{width:10px;height:10px;border-radius:2px;flex-shrink:0;}
.legend-line{width:16px;height:2px;flex-shrink:0;}
.legend-dash{width:16px;height:0;border-top:2px dashed;flex-shrink:0;}
.chart-wrap{position:relative;width:100%;height:230px;}
.chart-wrap-sm{position:relative;width:100%;height:200px;}

/* ── FUNNEL ── */
.funnel-wrap{padding:2px 0;}
.funnel-row{display:flex;align-items:center;gap:8px;margin-bottom:10px;}
.funnel-label-col{font-size:11px;color:var(--text2);width:80px;flex-shrink:0;font-weight:500;}
.funnel-track{flex:1;height:24px;background:#f5f0fa;border-radius:4px;overflow:hidden;}
.funnel-fill{height:100%;display:flex;align-items:center;padding-left:8px;transition:width 0.8s cubic-bezier(.4,0,.2,1);}
.funnel-pct{font-size:11px;font-weight:700;color:#fff;}
.funnel-right{font-size:11px;color:var(--text2);width:72px;text-align:right;flex-shrink:0;}

/* ── HEATMAP ── */
.heatmap-container{width:100%;}
.heatmap-table{border-collapse:collapse;font-size:10px;width:100%;table-layout:fixed;}
.heatmap-table th{color:var(--text3);font-weight:600;padding:3px 2px;text-align:center;white-space:nowrap;}
.heatmap-table th.row-header{text-align:left;padding-right:4px;width:32px;color:var(--text2);}
.hm-cell{height:22px;text-align:center;padding:2px 1px;border-radius:3px;font-weight:600;cursor:default;font-size:9.5px;}
.hm-cell:hover{opacity:0.75;}

/* ── MINI CARD ── */
.mini-card{background:#fff;border:1px solid var(--border-card);border-radius:var(--radius);padding:14px 16px;}
.mini-title{font-size:12px;font-weight:700;color:var(--text);margin-bottom:8px;}
.mini-sub{font-size:11px;color:var(--text3);margin-bottom:10px;}
</style>
</head>
<body>

<!-- TOP NAV -->
<div class="topnav">
  <span class="nav-label">Báo Cáo Hiệu Suất Sale</span>
  <div class="nav-tabs">
    <div class="nav-tab active" id="tab1" onclick="showPage(1)"><span class="num">1</span> Tổng Quan</div>
    <div class="nav-tab" id="tab2" onclick="showPage(2)"><span class="num" style="background:#0ab5a0;">2</span> HSKD</div>
    <div class="nav-tab" id="tab3" onclick="showPage(3)"><span class="num" style="background:#3b6fd4;">3</span> Khách Hàng</div>
    <div class="nav-tab" id="tab4" onclick="showPage(4)"><span class="num" style="background:#d4960a;">4</span> Marketing</div>
    <div class="nav-tab" id="tab5" onclick="showPage(5)"><span class="num" style="background:#6b3fa0;">5</span> PP Phân Khúc KH</div>
  </div>
</div>

<div id="page1">
<!-- SUBHEADER -->
<div class="subheader">
  <div class="subheader-left">
    <h2>Tổng Quan Hiệu Suất</h2>
    <p>Doanh thu · Đơn hàng · Chuyển đổi · SLA · T6–T7/2025</p>
  </div>
  <div class="subheader-pills">
    <span class="sh-pill">3.42 tỷ doanh thu</span>
    <span class="sh-pill">4,420 đơn hàng</span>
    <span class="sh-pill">4.2% chuyển đổi</span>
  </div>
</div>

<!-- FILTERS -->
<div class="filters">
  <div class="filter-group">
    <span class="filter-label">Từ</span>
    <input type="date" id="dateFrom" value="2024-01-01">
    <span class="filter-sep">–</span>
    <input type="date" id="dateTo" value="2024-12-31">
  </div>
  <div class="filter-group">
    <span class="filter-label">Team</span>
    <select id="teamFilter">
      <option value="all">Tất cả team</option>
      <option>Team 1</option><option>Team 2</option><option>Team 3</option>
      <option>Team 4</option><option>Team 5</option>
    </select>
  </div>
  <button class="btn-reset" onclick="resetFilters()">Đặt lại</button>
</div>

<div class="main">

  <!-- ROW 1: KPI -->
  <div class="kpi-grid" style="grid-template-columns:repeat(7,1fr);">
    <div class="kpi-card k1">
      <div class="kpi-label">Tổng số KG</div>
      <div class="kpi-value">72.6K</div>
      <div class="kpi-trend"><span class="trend-up">▲ 18.2%</span><span class="kpi-sub">&nbsp;so kỳ trước</span></div>
    </div>
    <div class="kpi-card k2">
      <div class="kpi-label">Tổng doanh thu</div>
      <div class="kpi-value">3.42 tỷ</div>
      <div class="kpi-trend"><span class="trend-up">▲ 14.3%</span><span class="kpi-sub">&nbsp;so kỳ trước</span></div>
    </div>
    <div class="kpi-card k3">
      <div class="kpi-label">Tổng số đơn</div>
      <div class="kpi-value">4,420</div>
      <div class="kpi-trend"><span class="trend-up">▲ 11.7%</span><span class="kpi-sub">&nbsp;so kỳ trước</span></div>
    </div>
    <div class="kpi-card k4">
      <div class="kpi-label">Tổng số Lead</div>
      <div class="kpi-value">12,580</div>
      <div class="kpi-trend"><span class="trend-up">▲ 8.4%</span><span class="kpi-sub">&nbsp;so kỳ trước</span></div>
    </div>
    <div class="kpi-card k5">
      <div class="kpi-label">Tổng số KH</div>
      <div class="kpi-value">2,389</div>
      <div class="kpi-trend"><span class="trend-up">▲ 21.6%</span><span class="kpi-sub">&nbsp;so kỳ trước</span></div>
    </div>
    <div class="kpi-card k6">
      <div class="kpi-label">DT trung bình / KH</div>
      <div class="kpi-value">1.43M</div>
      <div class="kpi-trend"><span class="trend-down">▼ 6.0%</span><span class="kpi-sub">&nbsp;so kỳ trước</span></div>
    </div>
    <div class="kpi-card" style="border-top:3px solid #0ab5a0;">
      <div class="kpi-label">ROAS</div>
      <div class="kpi-value" style="color:#0ab5a0;">8.6x</div>
      <div class="kpi-trend"><span class="trend-up">▲ 1.2x</span><span class="kpi-sub">&nbsp;so kỳ trước</span></div>
    </div>
  </div>

  <!-- ROW 2: DT+KG/time | DT+KG/team | ROAS/time -->
  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;">
    <div class="chart-card">
      <div class="chart-header-row">
        <div class="chart-head">
          <div class="chart-title">Doanh thu & KG theo thời gian</div>
          <div class="chart-sub">Năm nay vs năm ngoái</div>
        </div>
        <div class="chart-filters" style="align-items:center;">
          <span style="font-size:11px;color:var(--text2);font-weight:600;">KG:</span>
          <select id="filterKg" onchange="applyChart1Filters()" style="background:#fff;border:1px solid var(--border-card);color:var(--text);padding:4px 10px;border-radius:var(--radius-sm);font-size:12px;cursor:pointer;outline:none;">
            <option value="both">Cả hai năm</option>
            <option value="ty">Năm nay</option>
            <option value="ly">Năm ngoái</option>
          </select>
          <span style="font-size:11px;color:var(--text2);font-weight:600;margin-left:6px;">DT:</span>
          <select id="filterRev" onchange="applyChart1Filters()" style="background:#fff;border:1px solid var(--border-card);color:var(--text);padding:4px 10px;border-radius:var(--radius-sm);font-size:12px;cursor:pointer;outline:none;">
            <option value="both">Cả hai năm</option>
            <option value="ty">Năm nay</option>
            <option value="ly">Năm ngoái</option>
          </select>
        </div>
      </div>
      <div class="legend">
        <span class="legend-item"><span class="legend-dot" style="background:#e91e8c;"></span>DT năm nay</span>
        <span class="legend-item"><span class="legend-dot" style="background:#fad0e8;border:1px solid #e91e8c;"></span>DT năm ngoái</span>
        <span class="legend-item"><span class="legend-line" style="background:#42a5f5;"></span>KG năm nay</span>
        <span class="legend-item"><span class="legend-dash" style="border-color:#42a5f5;"></span>KG năm ngoái</span>
      </div>
      <div class="chart-wrap"><canvas id="chart1" role="img" aria-label="DT và KG theo tháng">DT & KG 12 tháng.</canvas></div>
    </div>

    <div class="chart-card">
      <div class="chart-header-row">
        <div class="chart-head">
          <div class="chart-title">Doanh thu & KG theo Team</div>
          <div class="chart-sub">Doanh thu (cột) vs số KG (đường)</div>
        </div>
        <div class="chart-filters" style="align-items:center;">
          <span style="font-size:11px;color:var(--text2);font-weight:600;">KG:</span>
          <select id="filterKgTeam" onchange="applyChart2Filters()" style="background:#fff;border:1px solid var(--border-card);color:var(--text);padding:4px 10px;border-radius:var(--radius-sm);font-size:12px;cursor:pointer;outline:none;">
            <option value="both">Cả hai năm</option>
            <option value="ty">Năm nay</option>
            <option value="ly">Năm ngoái</option>
          </select>
          <span style="font-size:11px;color:var(--text2);font-weight:600;margin-left:6px;">DT:</span>
          <select id="filterRevTeam" onchange="applyChart2Filters()" style="background:#fff;border:1px solid var(--border-card);color:var(--text);padding:4px 10px;border-radius:var(--radius-sm);font-size:12px;cursor:pointer;outline:none;">
            <option value="both">Cả hai năm</option>
            <option value="ty">Năm nay</option>
            <option value="ly">Năm ngoái</option>
          </select>
        </div>
      </div>
      <div class="legend">
        <span class="legend-item"><span class="legend-dot" style="background:rgba(233,30,140,0.6);"></span>DT năm nay</span>
        <span class="legend-item"><span class="legend-dot" style="background:rgba(233,30,140,0.2);border:1px solid #e91e8c;"></span>DT năm ngoái</span>
        <span class="legend-item"><span class="legend-line" style="background:#42a5f5;"></span>KG năm nay</span>
        <span class="legend-item"><span class="legend-dash" style="border-color:#42a5f5;"></span>KG năm ngoái</span>
      </div>
      <div class="chart-wrap"><canvas id="chart2" role="img" aria-label="DT và KG theo 5 team">Team 1-5.</canvas></div>
    </div>

    <div class="chart-card">
      <div class="chart-head">
        <div class="chart-title">ROAS theo thời gian</div>
        <div class="chart-sub">Năm nay vs năm ngoái</div>
      </div>
      <div class="legend">
        <span class="legend-item"><span class="legend-line" style="background:#0ab5a0;"></span>ROAS năm nay</span>
        <span class="legend-item"><span class="legend-dash" style="border-color:#0ab5a0;opacity:0.55;"></span>ROAS năm ngoái</span>
      </div>
      <div class="chart-wrap"><canvas id="chartROAS" role="img" aria-label="ROAS theo tháng">ROAS T1-T12.</canvas></div>
    </div>
  </div>

  <!-- ROW 3: Phễu chuyển đổi | Số KH phát sinh đơn -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
    <div class="chart-card">
      <div class="chart-head">
        <div class="chart-title">Phễu chuyển đổi Lead</div>
        <div class="chart-sub">Toàn công ty · 2024</div>
      </div>
      <div class="funnel-wrap" id="funnelWrap"></div>
    </div>
    <div class="chart-card">
      <div class="chart-head">
        <div class="chart-title">Số KH phát sinh đơn theo tháng</div>
        <div class="chart-sub">KH theo tháng & lũy kế — năm nay</div>
      </div>
      <div class="legend">
        <span class="legend-item"><span class="legend-dot" style="background:rgba(233,30,140,0.6);"></span>KH theo tháng</span>
        <span class="legend-item"><span class="legend-line" style="background:#6b3fa0;"></span>Lũy kế KH</span>
      </div>
      <div class="chart-wrap"><canvas id="chart3" role="img" aria-label="KH phát sinh đơn theo tháng">KH T1-T12.</canvas></div>
    </div>
  </div>

  <!-- ROW 4: Cohort full width -->
  <div class="chart-card">
    <div class="chart-header-row">
      <div class="chart-head">
        <div class="chart-title">Cohort — Khách hàng quay lại</div>
        <div class="chart-sub">Tỉ lệ retention theo tháng bắt đầu</div>
      </div>
      <div style="display:flex;gap:8px;align-items:center;font-size:11px;color:var(--text3);">
        <span style="display:flex;align-items:center;gap:4px;"><span style="width:10px;height:10px;background:#6b3fa0;border-radius:2px;display:inline-block;"></span>≥80%</span>
        <span style="display:flex;align-items:center;gap:4px;"><span style="width:10px;height:10px;background:#c9a8e8;border-radius:2px;display:inline-block;"></span>40–60%</span>
        <span style="display:flex;align-items:center;gap:4px;"><span style="width:10px;height:10px;background:#e5d4f5;border-radius:2px;display:inline-block;"></span>≤20%</span>
      </div>
    </div>
    <div class="heatmap-container"><table class="heatmap-table" id="cohortTable"></table></div>
  </div>

</div>

</div><!-- /page1 -->

<div id="page2" style="display:none;">
<!-- PAGE 2 SUBHEADER -->
<div class="subheader" style="background:#0ab5a0;">
  <div class="subheader-left">
    <h2>HSKD — Hiệu Suất Kinh Doanh</h2>
    <p>KG · Doanh thu · Công nợ · Phân tích nguồn</p>
  </div>
  <div class="subheader-pills">
    <span class="sh-pill">72.6K kg</span>
    <span class="sh-pill">3.42 tỷ DT</span>
    <span class="sh-pill">2.98 tỷ DT thực</span>
  </div>
</div>
<!-- PAGE 2 FILTERS -->
<div class="filters">
  <div class="filter-group"><span class="filter-label">Từ</span><input type="date" value="2024-01-01"><span class="filter-sep">–</span><input type="date" value="2024-12-31"></div>
  <div class="filter-group"><span class="filter-label">Team</span><select><option>Tất cả team</option><option>Team 1</option><option>Team 2</option><option>Team 3</option><option>Team 4</option><option>Team 5</option></select></div>
  <div class="filter-group"><span class="filter-label">Level KH</span><select><option>Tất cả</option><option>Titan</option><option>VIP 1</option><option>VIP 2</option><option>VIP 3</option></select></div>
</div>

<div class="main">
  <!-- P2 ROW 1: KPI HSKD -->
  <div class="kpi-grid" style="grid-template-columns:repeat(7,1fr);">
    <div class="kpi-card k1"><div class="kpi-label">Tổng KG</div><div class="kpi-value">72.6K</div><div class="kpi-trend"><span class="trend-up">▲ 18.2%</span><span class="kpi-sub">&nbsp;so kỳ trước</span></div></div>
