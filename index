function buildSparkline(elId, data, color, filled){
  const el=document.getElementById(elId);
  if(!el)return;
  const W=el.offsetWidth||200, H=el.offsetHeight||60;
  const N=data.length, mx=Math.max(...data), mn=Math.min(...data);
  const range=mx-mn||1;
  const pad=4;
  const pts=data.map((v,i)=>{
    const x=pad+i*(W-pad*2)/(N-1);
    const y=H-pad-(v-mn)/range*(H-pad*2);
    return [x,y];
  });
  const lineD=pts.map((p,i)=>(i===0?`M${p[0]},${p[1]}`:`L${p[0]},${p[1]}`)).join(' ');
  const areaD=`${lineD} L${pts[N-1][0]},${H-pad} L${pts[0][0]},${H-pad} Z`;
  const svg=`<svg xmlns="http://www.w3.org/2000/svg" width="${W}" height="${H}" style="display:block;">
    ${filled?`<path d="${areaD}" fill="${color}22"/>` :''}
    <path d="${lineD}" fill="none" stroke="${color}" stroke-width="2" stroke-linejoin="round"/>
    ${pts.map(p=>`<circle cx="${p[0]}" cy="${p[1]}" r="2.5" fill="${color}"/>`).join('')}
  </svg>`;
  el.innerHTML=svg;
}

