function buildP3Cohorts(){
  const rL=months;
  const cL=['M+0','M+1','M+2','M+3','M+4','M+5','M+6','M+7','M+8','M+9','M+10','M+11','M+12'];
  // Retention cohort (blue)
  function csBlue(v){
    if(v===null)return'background:transparent;color:transparent;';
    if(v>=80)return'background:#3b6fd4;color:#fff;';
    if(v>=60)return'background:#6690d8;color:#fff;';
    if(v>=40)return'background:#99b5e8;color:#1a2a5a;';
    if(v>=20)return'background:#ccd8f2;color:#2a3a7a;';
    return'background:#eef2fc;color:#3b6fd4;';
  }
  // Revenue cohort (teal)
  const maxRev=Math.max(...p3RevCohort.flat().filter(v=>v!==null));
  function csTeal(v){
    if(v===null)return'background:transparent;color:transparent;';
    const r=v/maxRev;
    if(r>=0.8)return'background:#0ab5a0;color:#fff;';
    if(r>=0.6)return'background:#3dc9b8;color:#fff;';
    if(r>=0.4)return'background:#80dcd5;color:#005a52;';
    if(r>=0.2)return'background:#b8eeea;color:#006a60;';
    return'background:#e0f8f6;color:#0ab5a0;';
  }
  function buildCohortTable(id,data,fmtFn,cssFn){
    let h='<thead><tr><th class="row-header">Tháng</th>'+cL.map(c=>`<th>${c}</th>`).join('')+'</tr></thead><tbody>';
    data.forEach((row,i)=>{
      h+=`<tr><th class="row-header" style="color:var(--text2);">${rL[i]}</th>`;
      row.forEach(v=>{h+=`<td class="hm-cell" style="${cssFn(v)}">${v!==null?fmtFn(v):''}</td>`;});
      h+='</tr>';
    });
    document.getElementById(id).innerHTML=h+'</tbody>';
  }
  buildCohortTable('p3cohort1',p3RetentionCohort,v=>v+'%',csBlue);
  buildCohortTable('p3cohort2',p3RevCohort,v=>v.toFixed(1)+'M',csTeal);
}

