  h+=`<tr style="background:#eef2fc;"><th class="row-header" style="font-weight:700;color:#3b6fd4;padding:5px 6px;">Total</th>${colTotals.map(v=>`<td style="padding:4px 8px;text-align:center;font-weight:700;font-size:11px;color:#3b6fd4;">${v}</td>`).join('')}<td style="padding:4px 8px;text-align:center;font-weight:800;font-size:11px;color:#3b6fd4;">${grandTotal}</td></tr>`;
