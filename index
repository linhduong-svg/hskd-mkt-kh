  let rows='';

  window.matrixData.forEach((team,ti)=>{
    const tOpen=mxState[team.name].open;
    const bgTeam='#fdf0f9';
    const icon=tOpen?'▼':'▶';
    rows+=`<tr class="mx-team" style="background:${bgTeam};cursor:pointer;border-bottom:2px solid #e91e8c20;" onclick="toggleTeam('${team.name.replace(/'/g,"\'")}')">
      <td style="padding:9px 12px;font-weight:700;font-size:12px;position:sticky;left:0;background:${bgTeam};white-space:nowrap;">
        <span style="color:#e91e8c;margin-right:6px;font-size:10px;">${icon}</span>${team.name}
      </td>
      ${MX_COLS.map(c=>`<td style="padding:9px 10px;text-align:right;font-weight:700;font-size:12px;color:#1a1a2e;">${c.fmt(team[c.key])}</td>`).join('')}
    </tr>`;

    if(tOpen){
      team.children.forEach((nv,ni)=>{
        const nvOpen=mxState[team.name].nv[nv.name];
        const bgNV='#fff';
        const nvIcon=nvOpen?'▼':'▶';
        rows+=`<tr class="mx-nv" style="background:${bgNV};cursor:pointer;border-bottom:1px solid #f0e0ec;" onclick="toggleNV('${team.name.replace(/'/g,"\'")}','${nv.name.replace(/'/g,"\'")}')">
          <td style="padding:8px 12px 8px 28px;font-weight:600;font-size:11.5px;position:sticky;left:0;background:${bgNV};white-space:nowrap;">
            <span style="color:#7a4060;margin-right:6px;font-size:10px;">${nvIcon}</span>${nv.name}
          </td>
          ${MX_COLS.map(c=>`<td style="padding:8px 10px;text-align:right;font-size:11.5px;font-weight:600;color:#3a1a2e;">${c.fmt(nv[c.key])}</td>`).join('')}
        </tr>`;

        if(nvOpen){
          nv.children.forEach((ord,oi)=>{
            const bg=oi%2===0?'#fafafa':'#fff';
            rows+=`<tr style="background:${bg};border-bottom:1px solid #f5f0f8;">
              <td style="padding:6px 12px 6px 48px;font-size:11px;color:#5a3a5a;position:sticky;left:0;background:${bg};white-space:nowrap;">
